# Copie ce fichier en ".env" (sans ".example") avant de lancer docker compose.
# Le fichier ".env" ne doit JAMAIS être versionné sur GitHub (déjà exclu par .gitignore).

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-moi-un-mot-de-passe-solide

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET=

# URL du webhook de notification (Slack "Incoming Webhook" ou Discord "Webhook").
# Laisse vide pour l'instant : les fraudes seront simplement journalisées, sans envoi.
NOTIFY_WEBHOOK_URL=
NOTIFY_WEBHOOK_KIND=discord

# Chaîne de connexion Neon (trouvée dans le tableau de bord Neon, section "Connect").
NEON_CONNECTION_STRING=postgresql://<utilisateur>:<mot_de_passe>@<hote>.neon.tech/<base>?sslmode=require

# Sel utilisé pour pseudonymiser les numéros de carte avant stockage dans Neon.
# IMPORTANT : à générer UNE SEULE FOIS (ex. `python -c "import secrets;print(secrets.token_hex(16))"`),
# puis ne plus jamais changer : le changer romprait la correspondance avec les hachages déjà stockés.
HASH_SALT=secret-aleatoire
